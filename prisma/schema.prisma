generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  name      String
  email       String     @unique
  password String
  dni         String     @unique
  
  isIdentityVerified Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // RELACIONES INVERSAS (Prisma las necesita para saber que un usuario tiene muchos productos y reservas)
  products   Product[]
  reservations   Reservation[]
  role String @default("USER")
  isDeleted Boolean @default(false)
  profile Profile?
}

model Profile {
  id        String @id @default(uuid())
  description       String?
  avatar String?
  phone  String?
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id             String       @id @default(uuid())  
  title          String     
  descripcion    String    @db.Text 
  priceDay      Float
  priceMonth    Float
  zone           String
  city           String
  state          String
  address        String
  deposit       Float
  category      String
  ownerId String

  isAvailable     Boolean       @default(true)
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // RELACIONES
  owner      User   @relation(fields: [ownerId], references: [id])
  reservations       Reservation[] // Un producto puede tener muchas reservas anotadas
  photos     PhotoProduct[] // Un producto puede tener muchas fotos
}

model PhotoProduct {
  id        String @id @default(uuid())
  url       String
  publicId  String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Reservation {
  id          String       @id @default(uuid())
  dateInit DateTime 
  dateEnd    DateTime
  status      String

  actualHandoffAt  DateTime?
  actualReturnAt   DateTime?
  handoffNotes     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productId String
  userId String

  // RELACIONES
  product    Product @relation(fields: [productId], references: [id])
  user     User  @relation(fields: [userId], references: [id])
}
