generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  CANCELLED
  COMPLETED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String       @id @default(uuid())
  name      String
  email       String     @unique
  password String
  dni         String     @unique
  
  isIdentityVerified Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // RELACIONES INVERSAS (Prisma las necesita para saber que un usuario tiene muchos productos y reservas)
  products   Product[]
  reservations   Reservation[]
  role Role @default(USER)
  isDeleted Boolean @default(false)
  profile Profile?
  verificationRequest VerificationRequest?

  @@index([role])
  @@index([isDeleted])
}

model Profile {
  id        String @id @default(uuid())
  description       String?
  avatar String?
  phone  String?
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id             String       @id @default(uuid())  
  title          String     
  descripcion    String    @db.Text 
  priceDay      Decimal @db.Decimal(10,2)
  priceMonth    Decimal @db.Decimal(10,2)
  zone           String
  city           String
  state          String
  address        String
  deposit       Decimal @db.Decimal(10,2)
  category      String
  ownerId String

  isAvailable     Boolean       @default(true)
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // RELACIONES
  owner      User   @relation(fields: [ownerId], references: [id])
  reservations       Reservation[] // Un producto puede tener muchas reservas anotadas
  photos     PhotoProduct[] // Un producto puede tener muchas fotos

  @@index([ownerId])
  @@index([category])
  @@index([city])
  @@index([isDeleted])
}

model PhotoProduct {
  id        String @id @default(uuid())
  url       String
  publicId  String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Reservation {
  id          String       @id @default(uuid())
  dateInit DateTime 
  dateEnd    DateTime
  status      ReservationStatus @default(PENDING)

  actualHandoffAt  DateTime?
  actualReturnAt   DateTime?
  handoffNotes     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  cancellationConfirmedAt DateTime?
  paymentReceivedAt        DateTime?

  productId String
  userId String

  // RELACIONES
  product    Product @relation(fields: [productId], references: [id])
  user     User  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([dateInit])
}

model VerificationRequest {
  id          String             @id @default(uuid())
  userId      String             @unique
  frontUrl    String
  backUrl     String
  selfieUrl   String
  status      VerificationStatus @default(PENDING)
  reviewNotes String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status])
}
