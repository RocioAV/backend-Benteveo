generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  MODERATOR
}


model User {
  id          Int        @id @default(uuid())
  name      String
  email       String     @unique
  password String
  dni         String     @unique
  
  // RELACIONES INVERSAS (Prisma las necesita para saber que un usuario tiene muchos productos y reservas)
  products   Product[]
  reservations   Reservation[]
  roles Json @default('["USER"]')
  profile Profile?
}

model Profile {
  id        String @id @default(uuid())
  description       String?
  avatar String?
  user_id String @unique
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Product {
  id             Int       @id @default(uuid())  
  title         String     
  descripcion    String    @db.Text 
  price_day      Float
  price_month    Float
  zone           String
  city           String
  state          String
  address        String
  url_photo       String
  deposit       Float
  category      String

  // RELACIONES
  owner_id       User   @relation(fields: [duenio_id], references: [id])
  reservations       Reservation[] // Un producto puede tener muchas reservas anotadas
}

model Reservation {
  id          Int      @id @default(uuid())
  date_init DateTime 
  date_end    DateTime
  status      String

  // RELACIONES
  product    Product @relation(fields: [product_id], references: [id])
  user     User  @relation(fields: [user_id], references: [id])
  owner_id Product   @relation(fields: [product_id], references: [owner_id])
}
