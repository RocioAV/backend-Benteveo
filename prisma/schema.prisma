generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  CANCELLED
  COMPLETED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  dni      String @unique

  isIdentityVerified Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // RELACIONES INVERSAS (Prisma las necesita para saber que un usuario tiene muchos productos y reservas)
  products            Product[]
  reservations        Reservation[]
  role                Role                 @default(USER)
  isDeleted           Boolean              @default(false)
  profile             Profile?
  verificationRequest VerificationRequest?
  favorites           Favorite[]
  ratings             Rating[]
  comments            Comment[]
  givenRatings        UserRating[]         @relation("UserRatingRater")
  receivedRatings     UserRating[]         @relation("UserRatingRated")

  @@index([role])
  @@index([isDeleted])
}

model Profile {
  id          String  @id @default(uuid())
  description String?
  avatar      String?
  phone       String?
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String  @id @default(uuid())
  title       String
  descripcion String  @db.Text
  priceDay    Decimal @db.Decimal(10, 2)
  priceMonth  Decimal @db.Decimal(10, 2)
  zone        String
  city        String
  state       String
  address     String
  deposit     Decimal @db.Decimal(10, 2)
  category    String
  ownerId     String

  isAvailable Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  rating      Float?
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // RELACIONES
  owner        User           @relation(fields: [ownerId], references: [id])
  reservations Reservation[] // Un producto puede tener muchas reservas anotadas
  photos       PhotoProduct[] // Un producto puede tener muchas fotos
  favorites    Favorite[]
  ratings      Rating[]
  comments     Comment[]

  @@index([ownerId])
  @@index([category])
  @@index([city])
  @@index([isDeleted])
}

model PhotoProduct {
  id       String @id @default(uuid())
  url      String
  publicId String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Reservation {
  id          String            @id @default(uuid())
  dateInit    DateTime
  dateEnd     DateTime
  status      ReservationStatus @default(PENDING)
  totalAmount Decimal?          @db.Decimal(10, 2)

  actualHandoffAt  DateTime?
  renterReceivedAt DateTime?
  renterReturnedAt DateTime?
  actualReturnAt   DateTime?
  handoffNotes     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cancellationConfirmedAt DateTime?
  paymentReceivedAt       DateTime?

  productId String
  userId    String

  // RELACIONES
  product     Product      @relation(fields: [productId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  payment     Payment?
  userRatings UserRating[]

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([dateInit])
}

model VerificationRequest {
  id          String             @id @default(uuid())
  userId      String             @unique
  frontUrl    String
  backUrl     String
  selfieUrl   String
  status      VerificationStatus @default(PENDING)
  reviewNotes String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Payment {
  id                   String        @id @default(uuid())
  reservationId        String        @unique
  mercadoPagoPaymentId String?       @unique
  preferenceId         String?
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("ARS")
  paymentMethod        String?
  paymentTypeId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Rating {
  id        String   @id @default(uuid())
  score     Int
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String   @db.Text
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model UserRating {
  id            String   @id @default(uuid())
  score         Int
  reservationId String
  raterId       String
  ratedUserId   String
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rater       User        @relation("UserRatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser   User        @relation("UserRatingRated", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([reservationId, raterId])
  @@index([ratedUserId])
  @@index([reservationId])
}
