generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  MODERATOR
}


model User {
  id          String       @id @default(uuid())
  name      String
  email       String     @unique
  password String
  dni         String     @unique
  
  // RELACIONES INVERSAS (Prisma las necesita para saber que un usuario tiene muchos productos y reservas)
  products   Product[]
  reservations   Reservation[]
  roles Json @default("[\"USER\"]")
  profile Profile?
}

model Profile {
  id        String @id @default(uuid())
  description       String?
  avatar String?
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id             String       @id @default(uuid())  
  title          String     
  descripcion    String    @db.Text 
  priceDay      Float
  priceMonth    Float
  zone           String
  city           String
  state          String
  address        String
  urlPhoto       String
  deposit       Float
  category      String
  ownerId String

  // RELACIONES
  owner      User   @relation(fields: [ownerId], references: [id])
  reservations       Reservation[] // Un producto puede tener muchas reservas anotadas
}

model Reservation {
  id          String       @id @default(uuid())
  dateInit DateTime 
  dateEnd    DateTime
  status      String

  productId String
  userId String

  // RELACIONES
  product    Product @relation(fields: [productId], references: [id])
  user     User  @relation(fields: [userId], references: [id])
}
