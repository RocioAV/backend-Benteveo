# Copiá este archivo a `.env` y completá con tus valores locales.
# El `.env` real NO se versiona (está en .gitignore).

# PostgreSQL (local via docker-compose)
DATABASE_URL="postgresql://admin:CHANGE_ME@localhost:5435/benteveo-db?schema=public"
# Producción (Neon): usar el connection string directo de Neon
# (incluye `?sslmode=require`).

# JWT
JWT_SECRET="cambia-este-secreto"
JWT_EXPIRES_IN=60m

# CORS (origen del frontend, coma-separado si hay más de uno)
CORS_ORIGINS=http://localhost:5173

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# MercadoPago (https://www.mercadopago.com.ar/developers)
MP_ACCESS_TOKEN=tu_access_token_de_mp
FRONTEND_URL=http://localhost:5173
# Secreto de firma de webhooks (panel de MP > Webhooks > Secreto).
# Si se setea, el backend valida `x-signature` y rechaza notificaciones falsas.
# MP_WEBHOOK_SECRET=tu_secreto_de_firma

# --- Producción (Render) ---
# production habilita cookies `Secure` y el resto de los flags de prod.
NODE_ENV=development
# `none` cuando el front (Vercel) y el back (Render) están en dominios
# distintos: sin eso el navegador no manda la cookie de sesión en los fetch
# cross-site. Requiere HTTPS (siempre en Render/Vercel).
COOKIE_SAME_SITE=lax
# URL pública del backend (sin barra final) — se usa para armar el webhook.
BACKEND_URL=http://localhost:3000
# Webhook de MercadoPago (opcional; si BACKEND_URL está seteado se deriva solo).
# MP_WEBHOOK_URL=https://tu-api.onrender.com/api/v1/payments/webhook
